# Copy to .env and fill in. Never commit .env — in production these are Railway variables (ADR-013).
# Generate random secrets with: openssl rand -hex 32   (TOKEN_ENCRYPTION_KEY: openssl rand -base64 32)

# App
NODE_ENV=development            # development = Telegram long-polling, production = webhook
PORT=3000
LOG_LEVEL=info
APP_URL=                        # Railway-assigned public URL, e.g. https://croton-production.up.railway.app; required in production
TIMEZONE=Europe/Ljubljana
MONTHLY_LLM_BUDGET_EUR=14.00

# Telegram
TELEGRAM_BOT_TOKEN=             # from BotFather — use a separate dev bot locally: long polling deletes the prod webhook
TELEGRAM_WEBHOOK_SECRET=        # 16-256 chars of A-Z a-z 0-9 _ - (openssl rand -hex 32); required in production (ADR-012)
TELEGRAM_AUTHORIZED_CHAT_ID=    # your chat ID; every other chat is silently dropped (ADR-006)

# Claude API
ANTHROPIC_API_KEY=              # from console.anthropic.com
DISABLE_THINKING=false          # true = kill switch, turns off adaptive thinking on all Sonnet calls (ADR-005)

# Neon
DATABASE_URL=                   # Neon connection string (direct, non-pooler host)

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=    # random string for the webhook subscription handshake (ADR-012)

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth tokens (Strava/Google access + refresh) are stored encrypted in the DB, not here (ADR-011)
TOKEN_ENCRYPTION_KEY=           # 32 random bytes, base64

# Terra API
TERRA_API_KEY=                  # from Terra dashboard
TERRA_DEV_ID=                   # from Terra dashboard
TERRA_SIGNING_SECRET=           # for webhook signature verification

# OpenAI (embeddings only)
OPENAI_API_KEY=
